rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function valid(d) {
      return d.keys().hasOnly(['who','title','start','end'])
        && d.who in ['nathan','soohan','ryan','group']
        && d.title is string
        && d.title.trim().size() > 0
        && d.title.size() <= 80
        && d.start is timestamp
        && d.end is timestamp
        && d.end > d.start;
    }
    match /blocks/{id} {
      allow read, delete: if true;
      allow create, update: if valid(request.resource.data);
    }
  }
}
